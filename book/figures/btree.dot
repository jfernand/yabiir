// A B-tree of order 3 (at most two keys per node) holding Chapter 0's five keys,
// with the path a lookup for zx-spectrum takes drawn in amber.
// Rendered to btree.svg by tools/build.sh.
digraph btree {
  graph [bgcolor="transparent", nodesep=0.35, ranksep=0.45, pad=0.05];
  node  [shape=plain, fontname="IBM Plex Mono", fontsize=10, fontcolor="#1A1A1A"];
  edge  [color="#3A3A3A", penwidth=0.9, arrowsize=0.6];

  root [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#3A3A3A">
      <tr><td port="p0" width="10" bgcolor="#FFE280"> </td>
          <td bgcolor="#FFE280"><b>c64</b></td>
          <td port="p1" width="10" bgcolor="#FFE280"> </td></tr>
    </table>>];

  left [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#3A3A3A">
      <tr><td bgcolor="#FAFAF8">apple-ii</td><td bgcolor="#FAFAF8">bbc-micro</td></tr>
    </table>>];

  right [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#3A3A3A">
      <tr><td bgcolor="#FFE280">ibm-pc</td><td bgcolor="#FFE280"><b>zx-spectrum</b></td></tr>
    </table>>];

  root:p0:s -> left:n;
  root:p1:s -> right:n [color="#C98A00", penwidth=1.6];
}
